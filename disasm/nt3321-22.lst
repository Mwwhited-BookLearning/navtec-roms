14D6  CC E7 19   CZ X_19E7
14D9  20         RIM
14DA  E6 10      ANI 10H
14DC  CA EA 14   JZ TICK_CHK_KEYS
14DF  3E E0      MVI A,0E0H
14E1  32 01 D0   STA KDC_CMD                 ; 8279: end interrupt (clear IRQ)
14E4  3E 01      MVI A,01H
14E6  32 3B 70   STA KEY_CHANGED
14E9  C9         RET
TICK_CHK_KEYS:                               ; xref: j14DC
14EA  3A 3B 70   LDA KEY_CHANGED
14ED  FE 00      CPI 00H
14EF  C8         RZ

