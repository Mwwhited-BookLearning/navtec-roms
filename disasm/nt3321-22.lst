; SW_TO_DIGIT: convert a sensor row byte to a digit. Rows are 9's-complement BCD on bits 0..5:
; digit = 9 - (row & 3FH), valid (carry set) when row & 3FH <= 9. Otherwise returns
; 0BH for the blank position (carry clear).
SW_TO_DIGIT:                                 ; xref: c14F8 c1502 c150C c1515 c151E c1527 c142C c1441 c1456 c1475 c1486 c149A
14B5  E6 3F      ANI 3FH                     ; '?'
14B7  EE FF      XRI 0FFH
14B9  C6 0A      ADI 0AH
14BB  FE 0A      CPI 0AH
14BD  D8         RC
14BE  0F         RRC
14BF  0F         RRC
14C0  0F         RRC
14C1  0F         RRC
14C2  C6 0C      ADI 0CH
14C4  E6 0F      ANI 0FH
14C6  37         STC
14C7  3F         CMC
14C8  C9         RET

; TICK_TASK: run once per RST 7.5 tick. TICK_BCD += 2 (BCD); every 20 ticks call X_19E7.
; If RST 5.5 (8279 IRQ) is pending: send End-Interrupt (0E0H) and set KEY_CHANGED;
; on a later tick with KEY_CHANGED set, rescan the switches.
TICK_TASK:                                   ; xref: c048B
14C9  3A 3D 70   LDA TICK_BCD
14CC  3C         INR A
14CD  3C         INR A
14CE  EE 00      XRI 00H
14D0  27         DAA
14D1  32 3D 70   STA TICK_BCD
14D4  E6 3F      ANI 3FH                     ; '?'
14D6  CC E7 19   CZ X_19E7
14D9  20         RIM
14DA  E6 10      ANI 10H
14DC  CA EA 14   JZ TICK_CHK_KEYS
14DF  3E E0      MVI A,0E0H
14E1  32 01 D0   STA KDC_CMD                 ; 8279: end interrupt (clear IRQ)
14E4  3E 01      MVI A,01H
14E6  32 3B 70   STA KEY_CHANGED
14E9  C9         RET
TICK_CHK_KEYS:                               ; xref: j14DC
14EA  3A 3B 70   LDA KEY_CHANGED
14ED  FE 00      CPI 00H
14EF  C8         RZ

; SCAN_SWITCHES: read sensor rows 0..5 and 6..7. Row 0/1 -> SEL_A/SEL_B, rows 2..5 -> SW_D1..4,
; rows 6/7 bit 7/6 -> BTN_STATE / BUTTONS (push-button edges).
; SEL_B = 0CH (blank) enters set-up: SW_D1..4 latched to SW_HI/SW_LO; SW_D1 = blank selects
; a configuration item by SW_D2: 0-3 baud (110/300/1200/19200), 4-9 OPTIONS bits.
