; CALL_TICK_HOOK: jump through TICK_HOOK. Nothing in the fully-recovered ROM ever writes
; TICK_HOOK, so in practice it's only ever set (if at all) by the serial monitor's
; memory-write command - this is a runtime debug hook, not used by the firmware itself.
CALL_TICK_HOOK:                              ; xref: c0482
10DB  2A DA 70   LHLD TICK_HOOK
10DE  E9         PCHL

; SERIAL_POLL: 8251 receive state machine (RX_STATE / PROTO_STATE). See docs/serial-protocol.md.
; Also runs PLOT_OUT when OUT_MODE = 2.
SERIAL_POLL:                                 ; xref: c0466 j1102 j120D j1246 j1253 j1260 j126D j128F j12DC j12EB j1320 j134E
10DF  3A DC 70   LDA OUT_MODE
10E2  FE 02      CPI 02H
10E4  CC 58 13   CZ PLOT_OUT
10E7  3A E0 70   LDA RX_STATE
10EA  FE 00      CPI 00H
10EC  C2 05 11   JNZ RX_STATE_N
10EF  3A 01 C0   LDA USART_CTRL
10F2  1F         RAR                         ; RxRDY?
10F3  1F         RAR
10F4  D0         RNC
10F5  3A 00 C0   LDA USART_DATA
10F8  32 E1 70   STA RX_CHAR
10FB  3A E0 70   LDA RX_STATE
10FE  3C         INR A
10FF  32 E0 70   STA RX_STATE
1102  C3 DF 10   JMP SERIAL_POLL
RX_STATE_N:                                  ; xref: j10EC
1105  3A 01 C0   LDA USART_CTRL
1108  1F         RAR                         ; TxRDY?
1109  D0         RNC
110A  3A 03 E0   LDA PIO1_PC
110D  F6 01      ORI 01H
110F  32 03 E0   STA PIO1_PC
1112  3A E0 70   LDA RX_STATE
1115  3C         INR A
1116  32 E0 70   STA RX_STATE
1119  FE 02      CPI 02H
111B  C2 92 12   JNZ TX_STATE_N
111E  3A E1 70   LDA RX_CHAR
1121  FE 12      CPI 12H                     ; DC2: reset protocol
1123  C2 31 11   JNZ RX_CMD_14
1126  3E 00      MVI A,00H
1128  32 DD 70   STA PROTO_STATE
112B  32 DC 70   STA OUT_MODE
112E  C3 E4 11   JMP RX_DONE
RX_CMD_14:                                   ; xref: j1123
1131  FE 14      CPI 14H                     ; DC4: OUT_MODE = 1
1133  C2 3E 11   JNZ RX_CMD_07
1136  3E 01      MVI A,01H
1138  32 DC 70   STA OUT_MODE
113B  C3 E4 11   JMP RX_DONE
RX_CMD_07:                                   ; xref: j1133
113E  FE 07      CPI 07H                     ; BEL: reset print buffer, PROTO_STATE = 1
1140  C2 56 11   JNZ RX_CMD_05
1143  21 3E 70   LXI H,PRTBUF
1146  22 D1 70   SHLD PRTBUF_PTR
1149  3E 00      MVI A,00H
114B  32 DC 70   STA OUT_MODE
114E  3E 01      MVI A,01H
1150  32 DD 70   STA PROTO_STATE
1153  C3 E4 11   JMP RX_DONE
RX_CMD_05:                                   ; xref: j1140
1156  FE 05      CPI 05H                     ; ENQ: PROTO_STATE = 2
1158  C2 63 11   JNZ RX_PROTO_4
115B  3E 02      MVI A,02H
115D  32 DD 70   STA PROTO_STATE
1160  C3 E4 11   JMP RX_DONE
RX_PROTO_4:                                  ; xref: j1158
1163  3A DD 70   LDA PROTO_STATE
1166  FE 04      CPI 04H
1168  C2 90 11   JNZ RX_PROTO_5
116B  3A E1 70   LDA RX_CHAR
116E  FE 41      CPI 41H                     ; 'A'
1170  C2 7B 11   JNZ RX_PROTO_4B
1173  3E 05      MVI A,05H
1175  32 DD 70   STA PROTO_STATE
1178  C3 E4 11   JMP RX_DONE
RX_PROTO_4B:                                 ; xref: j1170
117B  FE 2C      CPI 2CH                     ; ','
117D  C2 88 11   JNZ RX_PROTO_RESET
1180  3E 06      MVI A,06H
1182  32 DD 70   STA PROTO_STATE
1185  C3 E4 11   JMP RX_DONE
RX_PROTO_RESET:                              ; xref: j117D
1188  3E 00      MVI A,00H
118A  32 DD 70   STA PROTO_STATE
118D  C3 E4 11   JMP RX_DONE
RX_PROTO_5:                                  ; xref: j1168
1190  3A DD 70   LDA PROTO_STATE
1193  FE 05      CPI 05H
1195  C2 B2 11   JNZ RX_PROTO_6
1198  3A E1 70   LDA RX_CHAR
119B  21 DE 70   LXI H,UNIT_ID
119E  BE         CMP M
119F  C2 AA 11   JNZ RX_PROTO_SET1
11A2  3E 02      MVI A,02H
11A4  32 DD 70   STA PROTO_STATE
11A7  C3 E4 11   JMP RX_DONE
RX_PROTO_SET1:                               ; xref: j119F j11C1
11AA  3E 01      MVI A,01H
11AC  32 DD 70   STA PROTO_STATE
11AF  C3 E4 11   JMP RX_DONE
RX_PROTO_6:                                  ; xref: j1195
11B2  3A DD 70   LDA PROTO_STATE
11B5  FE 06      CPI 06H
11B7  C2 CC 11   JNZ RX_CHK_ESC
11BA  3A E1 70   LDA RX_CHAR
11BD  21 DE 70   LXI H,UNIT_ID
11C0  BE         CMP M
11C1  C2 AA 11   JNZ RX_PROTO_SET1
11C4  3E 03      MVI A,03H
11C6  32 DD 70   STA PROTO_STATE
11C9  C3 E4 11   JMP RX_DONE
RX_CHK_ESC:                                  ; xref: j11B7
11CC  3A E1 70   LDA RX_CHAR
11CF  FE 1B      CPI 1BH                     ; ESC: PROTO_STATE = 4
11D1  C2 DC 11   JNZ RX_CHK_MON
11D4  3E 04      MVI A,04H
11D6  32 DD 70   STA PROTO_STATE
11D9  C3 E4 11   JMP RX_DONE
RX_CHK_MON:                                  ; xref: j11D1
11DC  3A DD 70   LDA PROTO_STATE
11DF  FE 03      CPI 03H
11E1  CA EA 11   JZ MON_CMD
RX_DONE:                                     ; xref: j112E j113B j1153 j1160 j1178 j1185 j118D j11A7 j11AF j11C9 j11D9
11E4  3E 00      MVI A,00H
11E6  32 E0 70   STA RX_STATE
11E9  C9         RET

; MON_CMD: memory monitor commands, active when PROTO_STATE = 3. Char is echoed first.
;   ' ' deposit MON_WORD low byte at (MON_PTR), advance   R back up one address
;   S set MON_PTR = MON_WORD   G call MON_WORD   M dump memory   K/P/O output mode 1/2/0
;   0-9 A-F shift hex digit into MON_WORD
MON_CMD:                                     ; xref: j11E1
11EA  3A E1 70   LDA RX_CHAR
11ED  32 00 C0   STA USART_DATA              ; echo command char
11F0  FE 20      CPI 20H                     ; ' '
11F2  C2 10 12   JNZ MON_CMD_R
11F5  3A E6 70   LDA MON_DIGIT_FLAG
11F8  FE 00      CPI 00H
11FA  2A E2 70   LHLD MON_PTR
11FD  CA 04 12   JZ MON_ADVANCE
1200  3A E4 70   LDA MON_WORD
1203  77         MOV M,A
MON_ADVANCE:                                 ; xref: j11FD
1204  23         INX H
1205  22 E2 70   SHLD MON_PTR
MON_CLR_DIGIT:                               ; xref: j121C j122A j1235
1208  3E 00      MVI A,00H
120A  32 E6 70   STA MON_DIGIT_FLAG
120D  C3 DF 10   JMP SERIAL_POLL
MON_CMD_R:                                   ; xref: j11F2
1210  FE 52      CPI 52H                     ; 'R'
1212  C2 1F 12   JNZ MON_CMD_S
1215  2A E2 70   LHLD MON_PTR
1218  2B         DCX H
1219  22 E2 70   SHLD MON_PTR
121C  C3 08 12   JMP MON_CLR_DIGIT
MON_CMD_S:                                   ; xref: j1212
121F  FE 53      CPI 53H                     ; 'S'
1221  C2 2D 12   JNZ MON_CMD_G
1224  2A E4 70   LHLD MON_WORD
1227  22 E2 70   SHLD MON_PTR
122A  C3 08 12   JMP MON_CLR_DIGIT
MON_CMD_G:                                   ; xref: j1221
122D  FE 47      CPI 47H                     ; 'G'
122F  C2 3C 12   JNZ MON_CMD_K
1232  CD 38 12   CALL MON_GO
1235  C3 08 12   JMP MON_CLR_DIGIT
MON_GO:                                      ; xref: c1232
1238  2A E4 70   LHLD MON_WORD
123B  E9         PCHL
MON_CMD_K:                                   ; xref: j122F
123C  FE 4B      CPI 4BH                     ; 'K'
123E  C2 49 12   JNZ MON_CMD_P
1241  3E 01      MVI A,01H
1243  32 DC 70   STA OUT_MODE
1246  C3 DF 10   JMP SERIAL_POLL
MON_CMD_P:                                   ; xref: j123E
1249  FE 50      CPI 50H                     ; 'P'
124B  C2 56 12   JNZ MON_CMD_M
124E  3E 02      MVI A,02H
1250  32 DC 70   STA OUT_MODE
1253  C3 DF 10   JMP SERIAL_POLL
MON_CMD_M:                                   ; xref: j124B
1256  FE 4D      CPI 4DH                     ; 'M'
1258  C2 63 12   JNZ MON_CMD_O
125B  3E 0C      MVI A,0CH
125D  32 E0 70   STA RX_STATE
1260  C3 DF 10   JMP SERIAL_POLL
MON_CMD_O:                                   ; xref: j1258
1263  FE 4F      CPI 4FH                     ; 'O'
1265  C2 70 12   JNZ MON_HEX_DIGIT
1268  3E 00      MVI A,00H
126A  32 DC 70   STA OUT_MODE
126D  C3 DF 10   JMP SERIAL_POLL
MON_HEX_DIGIT:                               ; xref: j1265
1270  FE 3A      CPI 3AH                     ; ':'
1272  FA 77 12   JM MON_HEX_SHIFT
1275  C6 09      ADI 09H
MON_HEX_SHIFT:                               ; xref: j1272
1277  E6 0F      ANI 0FH
1279  2A E4 70   LHLD MON_WORD
127C  29         DAD H
127D  29         DAD H
127E  29         DAD H
127F  29         DAD H
1280  B5         ORA L
1281  6F         MOV L,A
1282  22 E4 70   SHLD MON_WORD
1285  3E 00      MVI A,00H
1287  32 E0 70   STA RX_STATE
128A  3E 01      MVI A,01H
128C  32 E6 70   STA MON_DIGIT_FLAG
128F  C3 DF 10   JMP SERIAL_POLL
TX_STATE_N:                                  ; xref: j111B
1292  FE 03      CPI 03H
1294  CA D4 12   JZ TX_CR                    ; state 3: send CR
1297  FE 04      CPI 04H
1299  CA D7 12   JZ TX_LF                    ; state 4: send LF
129C  FE 05      CPI 05H
129E  CA 29 13   JZ TX_PTR_HI
12A1  FE 06      CPI 06H
12A3  CA 1A 13   JZ TX_ECHO                  ; state 6/8/B: echo char
12A6  FE 07      CPI 07H
12A8  CA 23 13   JZ TX_PTR_LO
12AB  FE 08      CPI 08H
12AD  CA 1A 13   JZ TX_ECHO
12B0  FE 09      CPI 09H
12B2  CA D1 12   JZ TX_SPACE                 ; state 9: send space
12B5  FE 0A      CPI 0AH
12B7  CA 51 13   JZ TX_MEM_BYTE
12BA  FE 0B      CPI 0BH
12BC  CA 1A 13   JZ TX_ECHO
12BF  FE 0C      CPI 0CH
12C1  C2 DF 12   JNZ TX_WAIT_TXRDY
12C4  AF         XRA A
12C5  32 E4 70   STA MON_WORD
12C8  32 E5 70   STA MON_WORD_HI
12CB  32 E0 70   STA RX_STATE

; TX_DASH: send '-'. The three LXI H instructions are 21H skip-prefixes over
; MVI A,' ' / MVI A,0DH / MVI A,0AH so that entries at 12D1/12D4/12D7 send those chars.
TX_DASH:                                     ; xref: j1300
12CE  3E 2D      MVI A,2DH                   ; '-'
TX_SPACE:                                    ; = 12D1, inside the next instruction (entered by jumping past the 21H prefix)
12D0  21 3E 20   LXI H,203EH                 ; 21H skip prefix: MVI A,' ' at 12D1
TX_CR:                                       ; = 12D4, inside the next instruction (entered by jumping past the 21H prefix)
12D3  21 3E 0D   LXI H,0D3EH                 ; 21H skip prefix: MVI A,0DH at 12D4
TX_LF:                                       ; = 12D7, inside the next instruction (entered by jumping past the 21H prefix)
12D6  21 3E 0A   LXI H,0A3EH                 ; 21H skip prefix: MVI A,0AH at 12D7
12D9  32 00 C0   STA USART_DATA
12DC  C3 DF 10   JMP SERIAL_POLL
TX_WAIT_TXRDY:                               ; xref: j12C1
12DF  3A 01 C0   LDA USART_CTRL
12E2  1F         RAR
12E3  1F         RAR
12E4  D2 EE 12   JNC TX_DUMP_STATE
12E7  AF         XRA A
12E8  32 E0 70   STA RX_STATE
12EB  C3 DF 10   JMP SERIAL_POLL
TX_DUMP_STATE:                               ; xref: j12E4
12EE  3A E0 70   LDA RX_STATE
12F1  FE 0D      CPI 0DH
12F3  CA 03 13   JZ TX_DUMP_BYTE
12F6  FE 0E      CPI 0EH
12F8  CA 1A 13   JZ TX_ECHO
12FB  3E 0C      MVI A,0CH
12FD  32 E0 70   STA RX_STATE
1300  C3 CE 12   JMP TX_DASH
TX_DUMP_BYTE:                                ; xref: j12F3
1303  2A E4 70   LHLD MON_WORD
1306  3A E7 70   LDA MON_LAST
1309  BE         CMP M
130A  CA 14 13   JZ TX_DUMP_SAME
130D  7E         MOV A,M
130E  32 E7 70   STA MON_LAST
1311  C3 2C 13   JMP TX_HEX_BYTE
TX_DUMP_SAME:                                ; xref: j130A
1314  3E 0C      MVI A,0CH
1316  32 E0 70   STA RX_STATE
1319  C9         RET
TX_ECHO:                                     ; xref: j12A3 j12AD j12BC j12F8
131A  3A E1 70   LDA RX_CHAR
131D  32 00 C0   STA USART_DATA
1320  C3 DF 10   JMP SERIAL_POLL
TX_PTR_LO:                                   ; xref: j12A8
1323  3A E2 70   LDA MON_PTR
1326  C3 2C 13   JMP TX_HEX_BYTE
TX_PTR_HI:                                   ; xref: j129E
1329  3A E3 70   LDA MON_PTR_HI
TX_HEX_BYTE:                                 ; xref: j1311 j1355 j1326
132C  F5         PUSH PSW
132D  1F         RAR
132E  1F         RAR
132F  1F         RAR
1330  1F         RAR
1331  E6 0F      ANI 0FH
1333  FE 0A      CPI 0AH
1335  FA 3A 13   JM TX_HEX_HI
1338  C6 07      ADI 07H
TX_HEX_HI:                                   ; xref: j1335
133A  C6 30      ADI 30H                     ; '0'
133C  32 00 C0   STA USART_DATA
133F  F1         POP PSW
1340  E6 0F      ANI 0FH
1342  FE 0A      CPI 0AH
1344  FA 49 13   JM TX_HEX_LO
1347  C6 07      ADI 07H
TX_HEX_LO:                                   ; xref: j1344
1349  C6 30      ADI 30H                     ; '0'
134B  32 E1 70   STA RX_CHAR
134E  C3 DF 10   JMP SERIAL_POLL
TX_MEM_BYTE:                                 ; xref: j12B7
1351  2A E2 70   LHLD MON_PTR
1354  7E         MOV A,M
1355  C3 2C 13   JMP TX_HEX_BYTE

; PLOT_OUT: strip-chart output mode. Emits CR, LF then 80 columns with ' ' / '!' / '"' / '#'
; marking the two values from PLOT_VALUES.
PLOT_OUT:                                    ; xref: c10E4
1358  3A 01 C0   LDA USART_CTRL
135B  0F         RRC
135C  D0         RNC
135D  3A 03 E0   LDA PIO1_PC
1360  B1         ORA C
1361  32 03 E0   STA PIO1_PC
1364  3A CF 70   LDA PLOT_COL
1367  FE 50      CPI 50H                     ; 'P'
1369  16 0D      MVI D,0DH
136B  CA A2 13   JZ PLOT_SEND
136E  3A CF 70   LDA PLOT_COL
1371  FE 51      CPI 51H                     ; 'Q'
1373  C2 88 13   JNZ PLOT_COLUMN
1376  3E 00      MVI A,00H
1378  32 CF 70   STA PLOT_COL
137B  CD AB 13   CALL PLOT_VALUES
137E  60         MOV H,B
137F  69         MOV L,C
1380  22 E8 70   SHLD PLOT_BASE
1383  16 0A      MVI D,0AH
1385  C3 A2 13   JMP PLOT_SEND
PLOT_COLUMN:                                 ; xref: j1373
1388  2A E8 70   LHLD PLOT_BASE
138B  44         MOV B,H
138C  4D         MOV C,L
138D  16 20      MVI D,20H                   ; ' '
138F  3A CF 70   LDA PLOT_COL
1392  B8         CMP B
1393  C2 9A 13   JNZ PLOT_CHK_C
1396  7A         MOV A,D
1397  F6 01      ORI 01H
1399  57         MOV D,A
PLOT_CHK_C:                                  ; xref: j1393
139A  B9         CMP C
139B  C2 A2 13   JNZ PLOT_SEND
139E  7A         MOV A,D
139F  F6 02      ORI 02H
13A1  57         MOV D,A
PLOT_SEND:                                   ; xref: j136B j1385 j139B
13A2  21 CF 70   LXI H,PLOT_COL
13A5  34         INR M
13A6  7A         MOV A,D
13A7  32 00 C0   STA USART_DATA
13AA  C9         RET
PLOT_VALUES:                                 ; xref: c137B
13AB  3A C5 6F   LDA SEL_A
13AE  21 38 6F   LXI H,REC_MASTER_14
13B1  FE 0A      CPI 0AH
13B3  D2 CC 13   JNC PV_SCALE
13B6  21 04 6F   LXI H,SLOT_FLAGS
13B9  85         ADD L
13BA  6F         MOV L,A
13BB  7E         MOV A,M
13BC  21 51 6F   LXI H,REC_SEC_14
PV_INDEX:                                    ; xref: j13C9
13BF  E6 03      ANI 03H
13C1  11 19 00   LXI D,0019H                 ; record stride 25
13C4  3D         DCR A
13C5  FA CC 13   JM PV_SCALE
13C8  19         DAD D
13C9  C3 BF 13   JMP PV_INDEX
PV_SCALE:                                    ; xref: j13B3 j13C5
13CC  7E         MOV A,M
13CD  0F         RRC
13CE  0F         RRC
13CF  C6 08      ADI 08H
13D1  E6 3F      ANI 3FH                     ; '?'
13D3  3C         INR A
13D4  3C         INR A
13D5  3C         INR A
13D6  47         MOV B,A
13D7  23         INX H
13D8  23         INX H
13D9  23         INX H
13DA  7E         MOV A,M
13DB  2F         CMA
13DC  0F         RRC
13DD  0F         RRC
13DE  C6 08      ADI 08H
13E0  E6 3F      ANI 3FH                     ; '?'
13E2  3C         INR A
13E3  3C         INR A
13E4  3C         INR A
13E5  4F         MOV C,A
13E6  C9         RET

; DISP_REFRESH: write the 8279 display RAM (cmd 90H = write, auto-inc, addr 0).
; 7 bytes: 3 pairs interleaving high nibbles of 7034..7036 with 7037..7039, then 703A.
; Reached by a plain JMP from L_1CEA, the shared display-commit tail used by
; SW_ERR_SHOW and friends.
DISP_REFRESH:                                ; xref: j1CF0
13E7  3E 90      MVI A,90H
13E9  32 01 D0   STA KDC_CMD
13EC  01 37 70   LXI B,DISP_ROW_B
13EF  21 34 70   LXI H,DISP_ROW_A
13F2  1E 03      MVI E,03H
DISP_LOOP:                                   ; xref: j1415
13F4  7E         MOV A,M
13F5  E6 F0      ANI 0F0H
13F7  57         MOV D,A
13F8  0A         LDAX B
13F9  0F         RRC
13FA  0F         RRC
13FB  0F         RRC
13FC  0F         RRC
13FD  E6 0F      ANI 0FH
13FF  B2         ORA D
1400  32 00 D0   STA KDC_DATA
1403  7E         MOV A,M
1404  07         RLC
1405  07         RLC
1406  07         RLC
1407  07         RLC
1408  E6 F0      ANI 0F0H
140A  57         MOV D,A
140B  0A         LDAX B
140C  E6 0F      ANI 0FH
140E  B2         ORA D
140F  32 00 D0   STA KDC_DATA
1412  23         INX H
1413  03         INX B
1414  1D         DCR E
1415  C2 F4 13   JNZ DISP_LOOP
1418  3A 3A 70   LDA DISP_EXTRA
141B  32 00 D0   STA KDC_DATA
141E  C9         RET

; READ_SWITCHES: read the 6 thumbwheel rows via the 8279 sensor RAM (cmd 50H).
; Rows 0,1 -> SEL_A/SEL_B (digit+1, must be 1..9); rows 2..5 -> GRI (first digit >= 4).
; Invalid settings call SW_ERR_SEL_A/SW_ERR_SEL_B/SW_ERR_GRI1..4 and retry.
READ_SWITCHES:                               ; xref: c00E9 j1438 j144D j145F j146A j147E j148F j14A8
141F  3E E0      MVI A,0E0H
1421  32 01 D0   STA KDC_CMD                 ; 8279: end interrupt
1424  3E 50      MVI A,50H                   ; 'P'
1426  32 01 D0   STA KDC_CMD                 ; 8279: read sensor RAM row 0, auto-inc
1429  3A 00 D0   LDA KDC_DATA
142C  CD B5 14   CALL SW_TO_DIGIT
142F  3C         INR A
1430  FE 0A      CPI 0AH
1432  DA 3B 14   JC RSW_SELB
1435  CD 90 19   CALL SW_ERR_SEL_A
1438  C3 1F 14   JMP READ_SWITCHES
RSW_SELB:                                    ; xref: j1432
143B  32 C5 6F   STA SEL_A
143E  3A 00 D0   LDA KDC_DATA
1441  CD B5 14   CALL SW_TO_DIGIT
1444  3C         INR A
1445  FE 0A      CPI 0AH
1447  DA 50 14   JC RSW_GRI1
144A  CD 95 19   CALL SW_ERR_SEL_B
144D  C3 1F 14   JMP READ_SWITCHES
RSW_GRI1:                                    ; xref: j1447
1450  32 C6 6F   STA SEL_B
1453  3A 00 D0   LDA KDC_DATA
1456  CD B5 14   CALL SW_TO_DIGIT
1459  DA 62 14   JC RSW_GRI1_CHK
145C  CD 9A 19   CALL SW_ERR_GRI1
145F  C3 1F 14   JMP READ_SWITCHES
RSW_GRI1_CHK:                                ; xref: j1459
1462  FE 04      CPI 04H
1464  D2 6D 14   JNC RSW_GRI2                ; GRI first digit must be 4..9
1467  CD 9A 19   CALL SW_ERR_GRI1
146A  C3 1F 14   JMP READ_SWITCHES
RSW_GRI2:                                    ; xref: j1464
146D  07         RLC
146E  07         RLC
146F  07         RLC
1470  07         RLC
1471  6F         MOV L,A
1472  3A 00 D0   LDA KDC_DATA
1475  CD B5 14   CALL SW_TO_DIGIT
1478  DA 81 14   JC RSW_GRI3
147B  CD 9F 19   CALL SW_ERR_GRI2
147E  C3 1F 14   JMP READ_SWITCHES
RSW_GRI3:                                    ; xref: j1478
1481  B5         ORA L
1482  6F         MOV L,A
1483  3A 00 D0   LDA KDC_DATA
1486  CD B5 14   CALL SW_TO_DIGIT
1489  DA 92 14   JC RSW_GRI4
148C  CD A4 19   CALL SW_ERR_GRI3
148F  C3 1F 14   JMP READ_SWITCHES
RSW_GRI4:                                    ; xref: j1489
1492  07         RLC
1493  07         RLC
1494  07         RLC
1495  07         RLC
1496  67         MOV H,A
1497  3A 00 D0   LDA KDC_DATA
149A  CD B5 14   CALL SW_TO_DIGIT
149D  DA AD 14   JC RSW_STORE_GRI
14A0  FE 0B      CPI 0BH
14A2  CA AB 14   JZ RSW_GRI4_BLANK
14A5  CD A9 19   CALL SW_ERR_GRI4
14A8  C3 1F 14   JMP READ_SWITCHES
