; TX_DASH: send '-'. The three LXI H instructions are 21H skip-prefixes over
; MVI A,' ' / MVI A,0DH / MVI A,0AH so that entries at 12D1/12D4/12D7 send those chars.
TX_DASH:                                     ; xref: j1300
12CE  3E 2D      MVI A,2DH                   ; '-'
TX_SPACE:                                    ; = 12D1, inside the next instruction (entered by jumping past the 21H prefix)
12D0  21 3E 20   LXI H,203EH                 ; 21H skip prefix: MVI A,' ' at 12D1
TX_CR:                                       ; = 12D4, inside the next instruction (entered by jumping past the 21H prefix)
12D3  21 3E 0D   LXI H,0D3EH                 ; 21H skip prefix: MVI A,0DH at 12D4
TX_LF:                                       ; = 12D7, inside the next instruction (entered by jumping past the 21H prefix)
12D6  21 3E 0A   LXI H,0A3EH                 ; 21H skip prefix: MVI A,0AH at 12D7
12D9  32 00 C0   STA USART_DATA
12DC  C3 DF 10   JMP SERIAL_POLL
