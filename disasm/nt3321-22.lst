
; ---- ORG 0000 ----

; Reset vector. Interrupts off, jump to INIT.
RESET:                                       ; refs: lxi068E
0000  F3         DI
0001  C3 72 00   JMP INIT

; Table of six 4-byte packed-BCD constants (little-endian, LS byte first).
; BCD_K_00080980 and BCD_K_00000110 are passed to X_0EC1 (missing half).
BCD_CONST_TBL:                               
0004  08 88 88 88  DB   08H,88H,88H,88H        ; |....|
0008  00 00 02 00  DB   00H,00H,02H,00H        ; |....|
000C  00 03 00 00  DB   00H,03H,00H,00H        ; |....|
0010  06 00 00 01  DB   06H,00H,00H,01H        ; |....|
BCD_K_00080980:                              ; refs: lxi0149
0014  00 08 09 80  DB   00H,08H,09H,80H        ; |....|
BCD_K_00000110:                              ; refs: lxi034A
0018  00 00 01 10  DB   00H,00H,01H,10H        ; |....|

; PULSE_PB2: pulse bit 2 of 8155#2 port B.
; PULSE_PB:  pulse the bits set in A on 8155#2 port B (XOR twice = toggle out and back).
; The 8155 output port latch is readable, so XRA M / MOV M,A works on the port.
PULSE_PB2:                                   ; xref: c005E c007A c0333
001C  3E 04      MVI A,04H
PULSE_PB:                                    ; xref: c0045 c0066 c00C1 c04B8 c033B
001E  21 02 F0   LXI H,PIO2_PB
0021  F5         PUSH PSW
0022  AE         XRA M
0023  77         MOV M,A
0024  F1         POP PSW
0025  AE         XRA M
0026  77         MOV M,A
0027  C9         RET

; CPY_GRI_TO_TOA: copy the 4-byte GRI_BCD into CUR_TOA (HL=GRI_BCD, BC=CUR_TOA).
; CPY4_TO_TOA:    copy 4 bytes from (HL) into CUR_TOA.
CPY_GRI_TO_TOA:                              ; xref: c012D c0191 c01D3
0028  21 1C 6F   LXI H,GRI_BCD
CPY4_TO_TOA:                                 ; xref: c0303 c03DC c0360
002B  01 A5 6F   LXI B,CUR_TOA
002E  C3 BB 07   JMP COPY4

; Three orphan bytes (never reached).
ORPHAN_0031:                                 
0031  30 18 3A   DB   30H,18H,3AH            ; |0.:|

; RST 6.5 interrupt: receiver sample-ready strobe.
; Entered only from the EI/NOP/DI window inside WAIT_SAMPLE, so the stack holds
; [ret into WAIT_SAMPLE][ret to WAIT_SAMPLE's caller]. The trailing POP B / RET discards
; the first and returns to the main-loop caller with A = B = PIO2_PC rotated left twice.
; Sets PIO1_PC bit 0 (busy) and acknowledges the receiver with a pulse on PIO2_PB bit 5.
RST65_ISR:                                   
0034  F3         DI
0035  3A 03 E0   LDA PIO1_PC
0038  F6 01      ORI 01H
003A  32 03 E0   STA PIO1_PC
003D  3A 03 F0   LDA PIO2_PC
0040  07         RLC
0041  07         RLC
0042  47         MOV B,A
0043  3E 20      MVI A,20H                   ; ' '
0045  CD 1E 00   CALL PULSE_PB
0048  3A A1 6F   LDA CUR_REC
004B  0F         RRC
004C  78         MOV A,B
004D  DA 70 00   JC ISR_EXIT
0050  3A 15 6F   LDA SAMPLE_CNT
0053  3C         INR A
0054  21 0E 6F   LXI H,WIN_END
0057  BE         CMP M
0058  78         MOV A,B
0059  C2 70 00   JNZ ISR_EXIT
005C  F5         PUSH PSW
005D  D5         PUSH D
005E  CD 1C 00   CALL PULSE_PB2
0061  CD 1D 0E   CALL X_0E1D
0064  3E 20      MVI A,20H                   ; ' '
0066  CD 1E 00   CALL PULSE_PB
0069  3E 01      MVI A,01H
006B  32 17 6F   STA SYNC_FLAG
006E  D1         POP D
006F  F1         POP PSW
ISR_EXIT:                                    ; xref: j004D j0059
0070  C1         POP B
0071  C9         RET

; INIT: cold start. Program the 8251 USART (mode 0DAH = async x16, 7 data, odd parity,
; 2 stop; command 37H = TxEN DTR RxE ER RTS), set SP, program both 8155s and the 8279,
; SIM 1DH = enable RST 6.5 only, clear RAM 6F00-70FB, read the front-panel switches,
; derive SLOT_COUNT from the GRI and fall into the acquisition sequence.
INIT:                                        ; xref: j0001
0072  3E DA      MVI A,0DAH
0074  32 01 C0   STA USART_CTRL              ; 8251 mode: async x16, 7 data bits, odd parity, 2 stop bits
0077  31 00 71   LXI SP,STACK_TOP
007A  CD 1C 00   CALL PULSE_PB2
007D  3E CD      MVI A,0CDH
007F  32 01 D0   STA KDC_CMD                 ; 8279: clear display and FIFO (CD=110 CA=1)
0082  3E D0      MVI A,0D0H
0084  32 04 E0   STA PIO1_TMRLO              ; 8155#1 timer = 07D0H (2000), square wave
0087  3E 47      MVI A,47H                   ; 'G'
0089  32 05 E0   STA PIO1_TMRHI
008C  3E CF      MVI A,0CFH
008E  32 00 E0   STA PIO1_CMD                ; 8155#1: PA out, PB out, PC out, start timer
0091  3E 82      MVI A,82H
0093  32 04 F0   STA PIO2_TMRLO              ; 8155#2 timer = 0082H (130) -> 1200 baud x16
0096  3E 40      MVI A,40H                   ; '@'
0098  32 05 F0   STA PIO2_TMRHI
009B  3E C3      MVI A,0C3H
009D  32 00 F0   STA PIO2_CMD                ; 8155#2: PA out, PB out, PC input, start timer
00A0  3E 8E      MVI A,8EH
00A2  32 02 F0   STA PIO2_PB                 ; 8155#2 port B idle pattern 8EH
00A5  3E 37      MVI A,37H                   ; '7'
00A7  32 01 C0   STA USART_CTRL              ; 8251 command: TxEN DTR RxE ER RTS
00AA  3E 1D      MVI A,1DH
00AC  30         SIM                         ; SIM 1DH: mask 5.5 & 7.5, enable 6.5, reset 7.5 latch
00AD  3E 04      MVI A,04H
00AF  32 01 D0   STA KDC_CMD                 ; 8279 mode: 8x8 display, encoded scan sensor matrix
00B2  3E 26      MVI A,26H                   ; '&'
00B4  32 01 D0   STA KDC_CMD                 ; 8279 clock prescaler = 6
00B7  3E 90      MVI A,90H
00B9  32 01 D0   STA KDC_CMD                 ; 8279: write display RAM, auto-increment, addr 0
00BC  CD 4C 1E   CALL X_1E4C
00BF  3E 20      MVI A,20H                   ; ' '
00C1  CD 1E 00   CALL PULSE_PB
00C4  06 00      MVI B,00H
00C6  21 00 6F   LXI H,RAM1_BASE
00C9  CD 0F 08   CALL FILL_ZERO              ; clear 6F00-6FFF
00CC  06 FC      MVI B,0FCH
00CE  21 00 70   LXI H,RAM2_BASE
00D1  CD 0F 08   CALL FILL_ZERO              ; clear 7000-70FB (keeps return address at 70FE)
00D4  3E 1B      MVI A,1BH
00D6  32 D9 6F   STA VAR_6FD9
00D9  3E 30      MVI A,30H                   ; '0'
00DB  32 DE 70   STA UNIT_ID
00DE  21 3E 70   LXI H,PRTBUF
00E1  22 D1 70   SHLD PRTBUF_PTR
00E4  3E FF      MVI A,0FFH
00E6  32 CB 6F   STA VAR_6FCB
00E9  CD 1F 14   CALL READ_SWITCHES          ; read thumbwheels: SEL_A, SEL_B, GRI
00EC  2A CC 6F   LHLD GRI_SW
00EF  22 1D 6F   SHLD GRI_VAL
00F2  21 1C 6F   LXI H,GRI_BCD
00F5  CD 61 05   CALL TOA_TO_BIN
00F8  D6 28      SUI 28H                     ; A = GRI-derived value - 40
00FA  1E 04      MVI E,04H
INIT_DIV10:                                  ; xref: j00FF
00FC  1C         INR E
00FD  D6 0A      SUI 0AH
00FF  F2 FC 00   JP INIT_DIV10
0102  7B         MOV A,E
0103  32 14 6F   STA SLOT_COUNT              ; SLOT_COUNT = 4 + (A-40)/10 + 1
0106  47         MOV B,A
0107  21 02 6F   LXI H,FIRST_SLOT
010A  36 01      MVI M,01H
010C  EB         XCHG
010D  2A C5 6F   LHLD SEL_A
0110  7D         MOV A,L                     ; L = SEL_A, H = SEL_B
0111  B8         CMP B
0112  F2 1F 01   JP INIT_CHK_SELB
0115  32 02 6F   STA FIRST_SLOT
0118  C5         PUSH B
0119  E5         PUSH H
011A  CD BD 1D   CALL X_1DBD
011D  E1         POP H
011E  C1         POP B
INIT_CHK_SELB:                               ; xref: j0112
011F  3A C6 6F   LDA SEL_B
0122  B8         CMP B
0123  F2 2D 01   JP ACQ_START
0126  BD         CMP L
0127  CA 2D 01   JZ ACQ_START
012A  CD BD 1D   CALL X_1DBD

; ACQ_START: (re)start master acquisition. Reached again whenever tracking is lost.
ACQ_START:                                   ; xref: j0123 j0127 j01FC j0202
012D  CD 28 00   CALL CPY_GRI_TO_TOA
0130  21 A5 6F   LXI H,CUR_TOA
0133  CD 61 05   CALL TOA_TO_BIN
0136  D6 05      SUI 05H
0138  32 0E 6F   STA WIN_END
013B  3E 0E      MVI A,0EH
013D  CD B3 0D   CALL X_0DB3
0140  21 A1 6F   LXI H,CUR_REC
0143  01 24 6F   LXI B,REC_MASTER
0146  CD BB 07   CALL COPY4
0149  21 14 00   LXI H,BCD_K_00080980
014C  CD C1 0E   CALL X_0EC1
014F  3E 0E      MVI A,0EH
0151  CD B3 0D   CALL X_0DB3
0154  21 A1 6F   LXI H,CUR_REC
0157  01 3D 6F   LXI B,REC_SEC
015A  CD BB 07   CALL COPY4
SEARCH_RESTART:                              ; xref: j01AD
015D  CD 7A 05   CALL RESET_PULSES
0160  01 24 6F   LXI B,REC_MASTER

; SEARCH_LOOP: search for the master phase code, alternating REC_MASTER / REC_SEC targets.
SEARCH_LOOP:                                 ; xref: j018B
0163  CD E6 0D   CALL X_0DE6
0166  CD 9B 04   CALL WAIT_EPOCH
0169  CD 59 04   CALL WAIT_SAMPLE
016C  AF         XRA A
016D  32 15 6F   STA SAMPLE_CNT
0170  CD D9 0E   CALL X_0ED9
0173  CD AF 05   CALL FIRST_SAMPLE
0176  37         STC
0177  CD C2 05   CALL MATCH_PULSES
017A  D2 8E 01   JNC SEARCH_VERIFY
017D  3A A9 6F   LDA CUR_NPULSE
0180  FE 00      CPI 00H
0182  01 24 6F   LXI B,REC_MASTER
0185  C2 8B 01   JNZ SEARCH_NEXT
0188  01 3D 6F   LXI B,REC_SEC
SEARCH_NEXT:                                 ; xref: j0185
018B  C3 63 01   JMP SEARCH_LOOP
SEARCH_VERIFY:                               ; xref: j017A
018E  CD 65 06   CALL SAMPLE_TO_BCD
0191  CD 28 00   CALL CPY_GRI_TO_TOA
0194  21 D1 6F   LXI H,BCD_DELTA_2
0197  CD C1 0E   CALL X_0EC1
019A  3E 0F      MVI A,0FH
019C  CD 79 0D   CALL X_0D79
019F  CD 9B 04   CALL WAIT_EPOCH
01A2  CD 59 04   CALL WAIT_SAMPLE
01A5  CD AE 04   CALL SHIFT_IN16
01A8  EE CA      XRI 0CAH                    ; compare shift-in byte with master phase code A (CA)
01AA  CA B0 01   JZ MASTER_FOUND
01AD  C3 5D 01   JMP SEARCH_RESTART

; MASTER_FOUND: master locked. Slot 0 flags = C8H, then 20 settle passes (SETTLE_CNT).
MASTER_FOUND:                                ; xref: j01AA
01B0  3E C8      MVI A,0C8H                  ; slot 0 flags = C8H
01B2  32 04 6F   STA SLOT_FLAGS
01B5  CD 84 05   CALL CLEAR_PULSES
01B8  3E 01      MVI A,01H
01BA  32 B7 6F   STA CUR_MODE
01BD  21 03 04   LXI H,0403H                 ; VAR_6FE7 = 03, VAR_6FE7+1 = 04
01C0  22 E7 6F   SHLD VAR_6FE7
01C3  3E 04      MVI A,04H
01C5  32 E6 6F   STA VAR_6FE6
01C8  3E 14      MVI A,14H                   ; 20 settle passes
01CA  32 54 6F   STA SETTLE_CNT
01CD  2A 1D 6F   LHLD GRI_VAL
01D0  22 19 6F   SHLD GRI_TMP_VAL
01D3  CD 28 00   CALL CPY_GRI_TO_TOA
01D6  3E 0F      MVI A,0FH
01D8  CD B3 0D   CALL X_0DB3
01DB  01 24 6F   LXI B,REC_MASTER
01DE  CD 3F 05   CALL LOAD_REC_HL

; SETTLE_LOOP: 20 iterations accumulating signal quality (QUAL_LO/QUAL_HI).
SETTLE_LOOP:                                 ; xref: j01F4
01E1  CD E3 0D   CALL X_0DE3
01E4  CD 9B 04   CALL WAIT_EPOCH
01E7  CD 17 08   CALL X_0817
01EA  CD 12 04   CALL QUAL_UPDATE
01ED  CD D9 0E   CALL X_0ED9
01F0  21 54 6F   LXI H,SETTLE_CNT
01F3  35         DCR M
01F4  C2 E1 01   JNZ SETTLE_LOOP
01F7  3A 04 6F   LDA SLOT_FLAGS
01FA  E6 20      ANI 20H                     ; ' '
01FC  CA 2D 01   JZ ACQ_START
01FF  CD 45 04   CALL QUAL_CHECK
0202  DA 2D 01   JC ACQ_START
0205  3E 03      MVI A,03H
0207  32 3A 6F   STA REC_MASTER_16
020A  3E 10      MVI A,10H
020C  32 E7 6F   STA VAR_6FE7
020F  CD 05 1E   CALL X_1E05
0212  CD 23 0F   CALL X_0F23
0215  01 24 6F   LXI B,REC_MASTER
0218  CD E6 0D   CALL X_0DE6

; TRACK_LOOP: steady-state tracking loop, one pass per GRI epoch.
TRACK_LOOP:                                  ; xref: j024A
021B  CD 9B 04   CALL WAIT_EPOCH
021E  CD EE 0E   CALL X_0EEE
0221  CD D9 0E   CALL X_0ED9
0224  3A C1 6F   LDA DISP_MODE
0227  FE 01      CPI 01H
0229  CA 37 02   JZ TRACK_DISP1
022C  FE 02      CPI 02H
022E  C2 3A 02   JNZ TRACK_UPDATE
0231  CD 08 0F   CALL X_0F08
0234  C3 3A 02   JMP TRACK_UPDATE
TRACK_DISP1:                                 ; xref: j0229
0237  CD 31 0F   CALL X_0F31
TRACK_UPDATE:                                ; xref: j022E j0234
023A  CD 17 08   CALL X_0817

; TRACK_NEXT_SLOT: advance SLOT_IDX (wraps at SLOT_COUNT); skip slots without bit 7.
TRACK_NEXT_SLOT:                             ; xref: j0255 j025F j02B3 j02ED j031A
023D  21 11 6F   LXI H,SLOT_IDX
0240  34         INR M
0241  3A 14 6F   LDA SLOT_COUNT
0244  BE         CMP M
0245  C2 4D 02   JNZ TRACK_SLOT_CHK
0248  36 00      MVI M,00H
024A  C3 1B 02   JMP TRACK_LOOP
TRACK_SLOT_CHK:                              ; xref: j0245
024D  CD E1 04   CALL GET_SLOT_FLAGS
0250  47         MOV B,A
0251  07         RLC
0252  DA 58 02   JC TRACK_SLOT_BIT6
0255  C3 3D 02   JMP TRACK_NEXT_SLOT
TRACK_SLOT_BIT6:                             ; xref: j0252
0258  07         RLC
0259  D2 62 02   JNC SLOT_PROCESS
025C  CD A9 08   CALL X_08A9
025F  C3 3D 02   JMP TRACK_NEXT_SLOT

; SLOT_PROCESS: load slot record into CUR_REC and dispatch on TRACK_STATE:
;   bit7 -> SLOT_TRACKING, bit6 -> SLOT_ACQUIRE, else initial window search.
SLOT_PROCESS:                                ; xref: j0259
0262  CD 22 05   CALL LOAD_CUR_REC
0265  21 13 6F   LXI H,TRACK_STATE
0268  7E         MOV A,M
0269  07         RLC
026A  DA 1D 03   JC SLOT_TRACKING
026D  07         RLC
026E  DA 93 03   JC SLOT_ACQUIRE
0271  36 01      MVI M,01H
0273  3A 01 6F   LDA ACQ_COUNT
0276  FE 00      CPI 00H
0278  CC 1A 0E   CZ X_0E1A
027B  3E 64      MVI A,64H                   ; 'd'
027D  32 DD 6F   STA MISS_LIMIT
0280  3A 11 6F   LDA SLOT_IDX
0283  F5         PUSH PSW
0284  57         MOV D,A
0285  0E 0A      MVI C,0AH
0287  CD C6 07   CALL MUL8                   ; BC = SLOT_IDX * 10
028A  3E 10      MVI A,10H
028C  81         ADD C
028D  32 0E 6F   STA WIN_END
0290  79         MOV A,C
0291  32 A9 6F   STA CUR_NPULSE
0294  F1         POP PSW
0295  F5         PUSH PSW
0296  3D         DCR A
0297  CA AA 02   JZ SLOT_CHK_NEXT
029A  CD E4 04   CALL GET_FLAGS_A
029D  07         RLC
029E  D2 AA 02   JNC SLOT_CHK_NEXT
02A1  1F         RAR
02A2  CD 5E 05   CALL SEC_TOA_TO_BIN
02A5  C6 0A      ADI 0AH
02A7  32 A9 6F   STA CUR_NPULSE
SLOT_CHK_NEXT:                               ; xref: j0297 j029E
02AA  F1         POP PSW
02AB  3C         INR A
02AC  21 14 6F   LXI H,SLOT_COUNT
02AF  BE         CMP M
02B0  C2 C9 02   JNZ SLOT_CHK_NEXT2
02B3  C3 3D 02   JMP TRACK_NEXT_SLOT
SLOT_USE_GRI:                                ; xref: j02CB
02B6  21 1C 6F   LXI H,GRI_BCD
02B9  CD 61 05   CALL TOA_TO_BIN
02BC  D6 04      SUI 04H
02BE  32 0E 6F   STA WIN_END
02C1  3E 82      MVI A,82H
02C3  32 DD 6F   STA MISS_LIMIT
02C6  C3 DF 02   JMP SLOT_WIN_CALC
SLOT_CHK_NEXT2:                              ; xref: j02B0
02C9  3C         INR A
02CA  BE         CMP M
02CB  CA B6 02   JZ SLOT_USE_GRI
02CE  3D         DCR A
02CF  CD E4 04   CALL GET_FLAGS_A
02D2  07         RLC
02D3  D2 DF 02   JNC SLOT_WIN_CALC
02D6  1F         RAR
02D7  CD 5E 05   CALL SEC_TOA_TO_BIN
02DA  D6 04      SUI 04H
02DC  32 0E 6F   STA WIN_END
SLOT_WIN_CALC:                               ; xref: j02D3 j02C6
02DF  3A A9 6F   LDA CUR_NPULSE
02E2  47         MOV B,A
02E3  21 0E 6F   LXI H,WIN_END
02E6  96         SUB M
02E7  2F         CMA
02E8  3C         INR A
02E9  3C         INR A
02EA  77         MOV M,A
02EB  FE 09      CPI 09H
02ED  FA 3D 02   JM TRACK_NEXT_SLOT
02F0  78         MOV A,B
02F1  CD 76 05   CALL BCD_INC_STORE
02F4  32 DF 6F   STA PULSE_BCD
02F7  CD 53 05   CALL COUNT_TRACKED
02FA  21 BA 6F   LXI H,CUR_FLAGS
02FD  7E         MOV A,M
02FE  B0         ORA B
02FF  77         MOV M,A
0300  21 D1 6F   LXI H,BCD_DELTA_2
0303  CD 2B 00   CALL CPY4_TO_TOA
0306  AF         XRA A
0307  32 DA 6F   STA MISS_CNT
030A  CD 7A 05   CALL RESET_PULSES
030D  3E 80      MVI A,80H
030F  32 13 6F   STA TRACK_STATE
SLOT_DONE_06:                                ; xref: j0363
0312  3E 06      MVI A,06H
SLOT_DONE:                                   ; xref: j0390
0314  32 A1 6F   STA CUR_REC
SLOT_SAVE_NEXT:                              ; xref: j03C3 j03C8
0317  CD 75 08   CALL SAVE_CUR_REC
031A  C3 3D 02   JMP TRACK_NEXT_SLOT

; SLOT_TRACKING: state 80H. Verify the pulse group; count misses (MISS_CNT / MISS_LIMIT).
SLOT_TRACKING:                               ; xref: j026A
031D  CD 59 04   CALL WAIT_SAMPLE
0320  CD 2D 0E   CALL X_0E2D
0323  CD AF 05   CALL FIRST_SAMPLE
0326  37         STC
0327  3F         CMC
0328  CD C2 05   CALL MATCH_PULSES
032B  F5         PUSH PSW
032C  3A 17 6F   LDA SYNC_FLAG
032F  0F         RRC
0330  DA 3E 03   JC SLOT_TRK_RESULT
0333  CD 1C 00   CALL PULSE_PB2
0336  CD 1D 0E   CALL X_0E1D
0339  3E 20      MVI A,20H                   ; ' '
033B  CD 1E 00   CALL PULSE_PB
SLOT_TRK_RESULT:                             ; xref: j0330
033E  F1         POP PSW
033F  D2 66 03   JNC SLOT_TRK_LOST
0342  3A A9 6F   LDA CUR_NPULSE
0345  FE 00      CPI 00H
0347  C2 63 03   JNZ SLOT_TRK_END
SLOT_TRK_MISS:                               ; xref: j03DF
034A  21 18 00   LXI H,BCD_K_00000110
034D  CD C1 0E   CALL X_0EC1
0350  21 DA 6F   LXI H,MISS_CNT
0353  34         INR M
0354  3A DD 6F   LDA MISS_LIMIT
0357  BE         CMP M
0358  C2 63 03   JNZ SLOT_TRK_END
035B  AF         XRA A
035C  77         MOV M,A
035D  21 DE 6F   LXI H,TOA_ALT
0360  CD 2B 00   CALL CPY4_TO_TOA
SLOT_TRK_END:                                ; xref: j0358 j0347
0363  C3 12 03   JMP SLOT_DONE_06
SLOT_TRK_LOST:                               ; xref: j033F
0366  3E 40      MVI A,40H                   ; '@'
0368  32 13 6F   STA TRACK_STATE
036B  CD 84 05   CALL CLEAR_PULSES
036E  01 D5 6F   LXI B,TOA_SAVE
0371  21 A5 6F   LXI H,CUR_TOA
0374  CD BB 07   CALL COPY4
0377  3A A6 6F   LDA CUR_TOA_1
037A  CD D9 07   CALL BCD_TO_BIN
037D  D6 09      SUI 09H
037F  21 15 6F   LXI H,SAMPLE_CNT
0382  86         ADD M
0383  CD EF 07   CALL BIN_TO_BCD
0386  32 A6 6F   STA CUR_TOA_1
SLOT_MODE3:                                  ; xref: j040F
0389  3E 03      MVI A,03H
038B  32 B7 6F   STA CUR_MODE
038E  3E 07      MVI A,07H
0390  C3 14 03   JMP SLOT_DONE

; SLOT_ACQUIRE: state 40H. Read the phase code, accumulate pulse counts, decide lock (state 80H).
SLOT_ACQUIRE:                                ; xref: j026E
0393  AF         XRA A
0394  32 15 6F   STA SAMPLE_CNT
0397  CD 59 04   CALL WAIT_SAMPLE
039A  CD 1A 0E   CALL X_0E1A
039D  CD D1 04   CALL READ_PHASE
03A0  3A BF 6F   LDA PHASE_CODE
03A3  21 A9 6F   LXI H,CUR_NPULSE
03A6  CD 71 06   CALL COUNT_BITS4
03A9  F5         PUSH PSW
03AA  78         MOV A,B
03AB  86         ADD M
03AC  77         MOV M,A
03AD  F1         POP PSW
03AE  23         INX H
03AF  CD 71 06   CALL COUNT_BITS4
03B2  78         MOV A,B
03B3  86         ADD M
03B4  77         MOV M,A
03B5  23         INX H
03B6  34         INR M
03B7  7E         MOV A,M
03B8  FE 04      CPI 04H
03BA  C2 C6 03   JNZ SLOT_ACQ_CHK8
03BD  CD 7F 06   CALL CHK_NPULSE
03C0  DA D1 03   JC SLOT_ACQ_FAIL
03C3  C3 17 03   JMP SLOT_SAVE_NEXT
SLOT_ACQ_CHK8:                               ; xref: j03BA
03C6  FE 08      CPI 08H
03C8  C2 17 03   JNZ SLOT_SAVE_NEXT
03CB  CD 7F 06   CALL CHK_NPULSE
03CE  D2 E2 03   JNC SLOT_ACQ_OK
SLOT_ACQ_FAIL:                               ; xref: j03C0
03D1  3E 80      MVI A,80H
03D3  32 13 6F   STA TRACK_STATE
03D6  CD 7A 05   CALL RESET_PULSES
03D9  21 D5 6F   LXI H,TOA_SAVE
03DC  CD 2B 00   CALL CPY4_TO_TOA
03DF  C3 4A 03   JMP SLOT_TRK_MISS
SLOT_ACQ_OK:                                 ; xref: j03CE
03E2  CD 05 1E   CALL X_1E05
03E5  32 03 6F   STA SLOT_RESULT
03E8  21 01 6F   LXI H,ACQ_COUNT
03EB  34         INR M
03EC  7E         MOV A,M
03ED  FE 01      CPI 01H
03EF  C2 F8 03   JNZ SLOT_ACQ_FLAGS
03F2  3A 11 6F   LDA SLOT_IDX
03F5  32 02 6F   STA FIRST_SLOT
SLOT_ACQ_FLAGS:                              ; xref: j03EF
03F8  3A BA 6F   LDA CUR_FLAGS
03FB  F5         PUSH PSW
03FC  CD 45 05   CALL BIT_OF_STA
03FF  B6         ORA M
0400  77         MOV M,A
0401  F1         POP PSW
0402  F6 C0      ORI 0C0H
0404  32 BA 6F   STA CUR_FLAGS
0407  3E 01      MVI A,01H
0409  32 DC 6F   STA NEW_DATA
040C  CD 84 05   CALL CLEAR_PULSES
040F  C3 89 03   JMP SLOT_MODE3

; QUAL_UPDATE: count zero bits in each nibble of PHASE_CODE into QUAL_LO/QUAL_HI (saturate at 40H).
QUAL_UPDATE:                                 ; xref: c01EA
0412  3A BF 6F   LDA PHASE_CODE
0415  2F         CMA
0416  2A D8 70   LHLD QUAL_LO
0419  1E 04      MVI E,04H
QUAL_LO_LOOP:                                ; xref: j0421
041B  0F         RRC
041C  D2 20 04   JNC QUAL_LO_NEXT
041F  2C         INR L
QUAL_LO_NEXT:                                ; xref: j041C
0420  1D         DCR E
0421  C2 1B 04   JNZ QUAL_LO_LOOP
0424  F5         PUSH PSW
0425  7D         MOV A,L
0426  FE 40      CPI 40H                     ; '@'
0428  DA 2D 04   JC QUAL_HI_START
042B  2E 40      MVI L,40H                   ; '@'
QUAL_HI_START:                               ; xref: j0428
042D  F1         POP PSW
042E  1E 04      MVI E,04H
QUAL_HI_LOOP:                                ; xref: j0436
0430  0F         RRC
0431  D2 35 04   JNC QUAL_HI_NEXT
0434  24         INR H
QUAL_HI_NEXT:                                ; xref: j0431
0435  1D         DCR E
0436  C2 30 04   JNZ QUAL_HI_LOOP
0439  7C         MOV A,H
043A  FE 40      CPI 40H                     ; '@'
043C  DA 41 04   JC QUAL_STORE
043F  26 40      MVI H,40H                   ; '@'
QUAL_STORE:                                  ; xref: j043C
0441  22 D8 70   SHLD QUAL_LO
0444  C9         RET

; QUAL_CHECK: carry set if either QUAL counter < 28H (poor signal).
QUAL_CHECK:                                  ; xref: c01FF
0445  2A D8 70   LHLD QUAL_LO
0448  7D         MOV A,L
0449  FE 28      CPI 28H                     ; '('
044B  DA 57 04   JC QUAL_BAD
044E  7C         MOV A,H
044F  FE 28      CPI 28H                     ; '('
0451  DA 57 04   JC QUAL_BAD
0454  37         STC
0455  3F         CMC
0456  C9         RET
QUAL_BAD:                                    ; xref: j044B j0451
0457  37         STC
0458  C9         RET

; WAIT_SAMPLE: idle/background loop. Opens a one-instruction interrupt window (EI NOP DI);
; when RST 6.5 fires the ISR returns directly to WAIT_SAMPLE's caller (see RST65_ISR).
; Between windows: optional expansion ROM hook at 2000H (signature 0A5H), serial receive,
; serial transmit, and, if RST 7.5 latched (RIM bit 6), the periodic tick tasks.
WAIT_SAMPLE:                                 ; xref: c0169 c01A2 c0397 j0498 c031D c05FE c05AF c049B
0459  FB         EI                          ; one-instruction window for RST 6.5
045A  00         NOP
045B  F3         DI
045C  F5         PUSH PSW
045D  D5         PUSH D
045E  3A 00 20   LDA EXTROM_SIG              ; expansion ROM present if 2000H = 0A5H
0461  FE A5      CPI 0A5H
0463  CC 01 20   CZ EXTROM_ENTRY
0466  CD DF 10   CALL SERIAL_POLL
0469  CD E0 16   CALL TX_SERVICE
046C  20         RIM
046D  E6 40      ANI 40H                     ; RIM bit 6 = RST 7.5 pending
046F  CA 8E 04   JZ WAIT_SAMPLE_END
0472  3A 03 E0   LDA PIO1_PC
0475  F6 01      ORI 01H                     ; PIO1 PC0 = busy
0477  32 03 E0   STA PIO1_PC
047A  3E 10      MVI A,10H
047C  30         SIM                         ; SIM 10H: reset RST 7.5 latch
047D  3A DA 70   LDA TICK_HOOK
0480  FE 00      CPI 00H
0482  C4 DB 10   CNZ CALL_TICK_HOOK
0485  CD 23 17   CALL REPORT_TASK
0488  CD C0 18   CALL X_18C0
048B  CD C9 14   CALL TICK_TASK
WAIT_SAMPLE_END:                             ; xref: j046F
048E  D1         POP D
048F  F1         POP PSW
0490  3A 03 E0   LDA PIO1_PC
0493  E6 FE      ANI 0FEH                    ; PIO1 PC0 = idle
0495  32 03 E0   STA PIO1_PC
0498  C3 59 04   JMP WAIT_SAMPLE

; WAIT_EPOCH: wait for a sample whose status (PIO2_PC bit 2, seen as bit 4 after RLC RLC) is set.
WAIT_EPOCH:                                  ; xref: c0166 c019F c01E4 c021B j04A2
049B  CD 59 04   CALL WAIT_SAMPLE
049E  47         MOV B,A
049F  E6 10      ANI 10H                     ; bit 4 = PIO2_PC bit 2 (epoch flag)
04A1  78         MOV A,B
04A2  CA 9B 04   JZ WAIT_EPOCH
04A5  3A 03 E0   LDA PIO1_PC
04A8  F6 01      ORI 01H
04AA  32 03 E0   STA PIO1_PC
04AD  C9         RET

; SHIFT_IN16: clock 8 bits out of the receiver shift register via PIO2_PB bit 4.
; PIO2_PC bit 4 -> B (phase-code stream), bit 3 -> C (second stream). Returns A = B.
SHIFT_IN16:                                  ; xref: c01A5 c04D1 c05B7
04AE  16 08      MVI D,08H
04B0  3A 03 F0   LDA PIO2_PC
04B3  C3 BE 04   JMP SHIFT_IN_BIT
SHIFT_IN_CLK:                                ; xref: j04CC
04B6  3E 10      MVI A,10H                   ; clock pulse on PIO2_PB bit 4
04B8  CD 1E 00   CALL PULSE_PB
04BB  3A 03 F0   LDA PIO2_PC
SHIFT_IN_BIT:                                ; xref: j04B3
04BE  07         RLC
04BF  07         RLC
04C0  07         RLC
04C1  07         RLC
04C2  F5         PUSH PSW
04C3  78         MOV A,B
04C4  17         RAL
04C5  47         MOV B,A
04C6  F1         POP PSW
04C7  07         RLC
04C8  79         MOV A,C
04C9  17         RAL
04CA  4F         MOV C,A
04CB  15         DCR D
04CC  C2 B6 04   JNZ SHIFT_IN_CLK
04CF  78         MOV A,B
04D0  C9         RET

; READ_PHASE: SHIFT_IN16 then XOR with PHASE_REF -> PHASE_CODE (2 bytes).
READ_PHASE:                                  ; xref: c039D
04D1  CD AE 04   CALL SHIFT_IN16
04D4  21 BB 6F   LXI H,PHASE_REF
04D7  11 BF 6F   LXI D,PHASE_CODE
04DA  AE         XRA M
04DB  12         STAX D
04DC  79         MOV A,C
04DD  AE         XRA M
04DE  13         INX D
04DF  12         STAX D
04E0  C9         RET

; GET_SLOT_FLAGS: A = SLOT_FLAGS[SLOT_IDX].  GET_FLAGS_A: A = SLOT_FLAGS[A].
GET_SLOT_FLAGS:                              ; xref: c024D c0522
04E1  3A 11 6F   LDA SLOT_IDX
GET_FLAGS_A:                                 ; xref: c029A c02CF c16CC c04F4
04E4  21 04 6F   LXI H,SLOT_FLAGS
04E7  85         ADD L
04E8  6F         MOV L,A
04E9  7E         MOV A,M
04EA  C9         RET

; GET_SLOT_REC: HL -> 25-byte station record for SLOT_IDX.
; Slot 0 = REC_MASTER; otherwise REC_SEC + 25 * (flags & 3).
GET_SLOT_REC:                                ; xref: c0528
04EB  3A 11 6F   LDA SLOT_IDX
04EE  21 24 6F   LXI H,REC_MASTER
04F1  FE 00      CPI 00H
04F3  C8         RZ
04F4  CD E4 04   CALL GET_FLAGS_A
04F7  21 3D 6F   LXI H,REC_SEC
04FA  C3 00 05   JMP REC_INDEX

; GET_SEC_TOA: HL -> REC_SEC_TOA + 25 * (A & 3).
GET_SEC_TOA:                                 ; xref: c055E
04FD  21 41 6F   LXI H,REC_SEC_TOA
REC_INDEX:                                   ; xref: j04FA
0500  E6 03      ANI 03H
0502  11 19 00   LXI D,0019H                 ; record stride 25
REC_INDEX_LOOP:                              ; xref: j0508
0505  3D         DCR A
0506  F8         RM
0507  19         DAD D
0508  C3 05 05   JMP REC_INDEX_LOOP

; MUL9_INDEX: A = (HL + 9*A). Patched: the original x10 body survives at OLD_MUL10.
MUL9_INDEX:                                  ; xref: c1062 c102E c17E7
050B  C5         PUSH B
050C  47         MOV B,A
050D  07         RLC
050E  80         ADD B
050F  47         MOV B,A
0510  07         RLC
0511  80         ADD B
0512  C3 1B 05   JMP MUL9_INDEX_2

; OLD_MUL10: dead code left by an in-place patch (PUSH B / RLC / MOV C,A / RLC / RLC / ADD C).
OLD_MUL10:                                   
0515  C5 07 4F 07 07 81  DB   0C5H,07H,4FH,07H,07H,81H; |..O...|
MUL9_INDEX_2:                                ; xref: j0512
051B  4F         MOV C,A
051C  06 00      MVI B,00H
051E  09         DAD B
051F  7E         MOV A,M
0520  C1         POP B
0521  C9         RET

; LOAD_CUR_REC: CUR_FLAGS = slot flags; copy the slot's 25-byte record into CUR_REC.
LOAD_CUR_REC:                                ; xref: c0262
0522  CD E1 04   CALL GET_SLOT_FLAGS
0525  32 BA 6F   STA CUR_FLAGS
0528  CD EB 04   CALL GET_SLOT_REC
052B  01 A1 6F   LXI B,CUR_REC
COPY25_TO_CUR:                               ; xref: j0542
052E  1E 19      MVI E,19H
0530  C3 BD 07   JMP COPY_E                  ; copy 25 bytes

; OLD_LOAD_REC: dead code left by an in-place patch (copied in the opposite direction).
OLD_LOAD_REC:                                
0533  CD E1 04 3A BA 6F  DB   0CDH,0E1H,04H,3AH,0BAH,6FH; |...:.o|
0539  77 CD EB 04 44 4D  DB   77H,0CDH,0EBH,04H,44H,4DH; |w...DM|
LOAD_REC_HL:                                 ; xref: c01DE
053F  21 A1 6F   LXI H,CUR_REC
0542  C3 2E 05   JMP COPY25_TO_CUR

; BIT_OF_STA: A = 1 << (A & 3), HL = TRACK_MASK.
BIT_OF_STA:                                  ; xref: c03FC
0545  21 0F 6F   LXI H,TRACK_MASK
0548  E6 03      ANI 03H
054A  47         MOV B,A
054B  3E 01      MVI A,01H
BIT_OF_LOOP:                                 ; xref: j0550
054D  05         DCR B
054E  F8         RM
054F  07         RLC
0550  C3 4D 05   JMP BIT_OF_LOOP

; COUNT_TRACKED: B = number of set bits in TRACK_MASK.
COUNT_TRACKED:                               ; xref: c02F7
0553  06 00      MVI B,00H
0555  3A 0F 6F   LDA TRACK_MASK
COUNT_TRK_LOOP:                              ; xref: j055B
0558  0F         RRC
0559  D0         RNC
055A  04         INR B
055B  C3 58 05   JMP COUNT_TRK_LOOP

; SEC_TOA_TO_BIN / TOA_TO_BIN: A = bin(HL[1]) + (HL[2] >= 60H BCD ? 1 : 0).
SEC_TOA_TO_BIN:                              ; xref: c02A2 c02D7
055E  CD FD 04   CALL GET_SEC_TOA
TOA_TO_BIN:                                  ; xref: c00F5 c0133 c02B9
0561  06 00      MVI B,00H
0563  23         INX H
0564  23         INX H
0565  7E         MOV A,M
0566  1F         RAR
0567  D6 30      SUI 30H                     ; '0'
0569  FA 6D 05   JM TOA_TO_BIN_2
056C  04         INR B
TOA_TO_BIN_2:                                ; xref: j0569
056D  2B         DCX H
056E  7E         MOV A,M
056F  C5         PUSH B
0570  CD D9 07   CALL BCD_TO_BIN
0573  C1         POP B
0574  80         ADD B
0575  C9         RET
BCD_INC_STORE:                               ; xref: c02F1
0576  3C         INR A
0577  C3 6A 06   JMP BIN_TO_DELTA

; RESET_PULSES: clear pulse list and reset CUR_PULSE_PTR to CUR_PULSES.
RESET_PULSES:                                ; xref: c015D c030A c03D6 c065C
057A  CD 84 05   CALL CLEAR_PULSES
057D  21 AA 6F   LXI H,CUR_PULSES
0580  22 AF 6F   SHLD CUR_PULSE_PTR
0583  C9         RET

; CLEAR_PULSES: zero 17 bytes from CUR_NPULSE (falls into FILL_ZERO in the missing half).
CLEAR_PULSES:                                ; xref: c01B5 c057A c040C c036B
0584  06 11      MVI B,11H
0586  21 A9 6F   LXI H,CUR_NPULSE
0589  C3 0F 08   JMP FILL_ZERO

; ORPHAN_058C: dead code from a patch, followed by the Loran-C phase-code table
; (CA F9 = master A / secondary A, 9F AC = master B / secondary B, each preceded by 21H LXI-skip).
ORPHAN_058C:                                 
058C  21 04 6F 7E 07 3F 1F 77  DB   21H,04H,6FH,7EH,07H,3FH,1FH,77H; |!.o~.?.w|
PHASE_CODE_TBL:                              
0594  07 21 CA   DB   07H,21H,0CAH           ; |.!.|
0597  F9 D8 21   DB   0F9H,0D8H,21H          ; |..!|
059A  9F AC C9   DB   9FH,0ACH,0C9H          ; |...|

; PHASE_MISMATCH: B = popcount(PHASE_REF XOR B) = number of phase-code bit errors.
PHASE_MISMATCH:                              ; xref: c05E2 c061E
059D  3A BB 6F   LDA PHASE_REF
05A0  A8         XRA B
05A1  0E 08      MVI C,08H
05A3  06 00      MVI B,00H
PM_LOOP:                                     ; xref: j05AB
05A5  07         RLC
05A6  D2 AA 05   JNC PM_NEXT
05A9  04         INR B
PM_NEXT:                                     ; xref: j05A6
05AA  0D         DCR C
05AB  C2 A5 05   JNZ PM_LOOP
05AE  C9         RET

; FIRST_SAMPLE: wait one sample, SAMPLE_CNT = 8, read shift register, SAMPLE_LO = C.
FIRST_SAMPLE:                                ; xref: c0173 c0323
05AF  CD 59 04   CALL WAIT_SAMPLE
05B2  3E 08      MVI A,08H
05B4  32 15 6F   STA SAMPLE_CNT
05B7  CD AE 04   CALL SHIFT_IN16
05BA  21 16 6F   LXI H,SAMPLE_LO
05BD  71         MOV M,C
05BE  23         INX H
05BF  36 00      MVI M,00H
05C1  C9         RET

; MATCH_PULSES: walk samples until WIN_END, matching the master phase code
; (0CAH on 'A' GRIs, 09FH on 'B' GRIs) and building the pulse-position list.
; Entry carry flag selects exact compare (CY=1) or 1-bit-tolerant compare (CY=0).
MATCH_PULSES:                                ; xref: c0177 c0328
05C2  F5         PUSH PSW
05C3  3A 16 6F   LDA SAMPLE_LO
05C6  21 A9 6F   LXI H,CUR_NPULSE
05C9  5E         MOV E,M
05CA  C3 D6 05   JMP MP_TEST
MP_NEXT_SAMPLE:                              ; xref: j0601
05CD  21 15 6F   LXI H,SAMPLE_CNT
05D0  34         INR M
05D1  23         INX H
05D2  07         RLC
05D3  7E         MOV A,M
05D4  17         RAL
05D5  77         MOV M,A
MP_TEST:                                     ; xref: j05CA
05D6  47         MOV B,A
05D7  7B         MOV A,E
05D8  FE 00      CPI 00H
05DA  C2 19 06   JNZ MP_HAVE_PULSES
05DD  F1         POP PSW
05DE  F5         PUSH PSW
05DF  DA EE 05   JC MP_MASTER_A
05E2  CD 9D 05   CALL PHASE_MISMATCH
05E5  78         MOV A,B
05E6  FE 02      CPI 02H
05E8  DA 07 06   JC MP_ADD_PULSE
05EB  C3 F4 05   JMP MP_CHK_END
MP_MASTER_A:                                 ; xref: j05DF
05EE  3E CA      MVI A,0CAH                  ; master phase code, GRI A
05F0  A8         XRA B
05F1  CA 07 06   JZ MP_ADD_PULSE
MP_CHK_END:                                  ; xref: j05EB j0616
05F4  3A 15 6F   LDA SAMPLE_CNT
05F7  21 0E 6F   LXI H,WIN_END
05FA  BE         CMP M
05FB  CA 04 06   JZ MP_DONE_C
MP_WAIT:                                     ; xref: j0659
05FE  CD 59 04   CALL WAIT_SAMPLE
0601  C3 CD 05   JMP MP_NEXT_SAMPLE
MP_DONE_C:                                   ; xref: j05FB j065F
0604  F1         POP PSW
0605  37         STC
0606  C9         RET
MP_ADD_PULSE:                                ; xref: j05E8 j05F1
0607  2A AF 6F   LHLD CUR_PULSE_PTR
060A  3A 15 6F   LDA SAMPLE_CNT
060D  77         MOV M,A
060E  23         INX H
060F  22 AF 6F   SHLD CUR_PULSE_PTR
0612  21 A9 6F   LXI H,CUR_NPULSE
0615  34         INR M
0616  C3 F4 05   JMP MP_CHK_END
MP_HAVE_PULSES:                              ; xref: j05DA
0619  F1         POP PSW
061A  F5         PUSH PSW
061B  DA 24 06   JC MP_MASTER_B
061E  CD 9D 05   CALL PHASE_MISMATCH
0621  C3 28 06   JMP MP_FIND
MP_MASTER_B:                                 ; xref: j061B
0624  3E 9F      MVI A,9FH                   ; master phase code, GRI B
0626  A8         XRA B
0627  47         MOV B,A
MP_FIND:                                     ; xref: j0621
0628  3A 15 6F   LDA SAMPLE_CNT
062B  4F         MOV C,A
062C  21 AA 6F   LXI H,CUR_PULSES
062F  16 05      MVI D,05H
MP_FIND_LOOP:                                ; xref: j0638
0631  79         MOV A,C
0632  BE         CMP M
0633  CA 3E 06   JZ MP_FOUND
0636  23         INX H
0637  15         DCR D
0638  C2 31 06   JNZ MP_FIND_LOOP
063B  C3 4F 06   JMP MP_CHK_END2
MP_FOUND:                                    ; xref: j0633
063E  78         MOV A,B
063F  FE 00      CPI 00H
0641  CA 62 06   JZ MP_DONE_NC
0644  F1         POP PSW
0645  F5         PUSH PSW
0646  DA 4F 06   JC MP_CHK_END2
0649  78         MOV A,B
064A  FE 02      CPI 02H
064C  DA 62 06   JC MP_DONE_NC
MP_CHK_END2:                                 ; xref: j063B j0646
064F  3A 15 6F   LDA SAMPLE_CNT
0652  21 0E 6F   LXI H,WIN_END
0655  BE         CMP M
0656  CA 5C 06   JZ MP_WINDOW_END
0659  C3 FE 05   JMP MP_WAIT
MP_WINDOW_END:                               ; xref: j0656
065C  CD 7A 05   CALL RESET_PULSES
065F  C3 04 06   JMP MP_DONE_C
MP_DONE_NC:                                  ; xref: j0641 j064C
0662  F1         POP PSW
0663  AF         XRA A
0664  C9         RET

; SAMPLE_TO_BCD: BCD_DELTA_3 = BCD(SAMPLE_CNT - 9).  BIN_TO_DELTA: BCD_DELTA_3 = BCD(A).
SAMPLE_TO_BCD:                               ; xref: c018E
0665  3A 15 6F   LDA SAMPLE_CNT
0668  D6 09      SUI 09H
BIN_TO_DELTA:                                ; xref: j0577
066A  CD EF 07   CALL BIN_TO_BCD
066D  32 D2 6F   STA BCD_DELTA_3
0670  C9         RET

; COUNT_BITS4: B = popcount of low 4 bits of A.
COUNT_BITS4:                                 ; xref: c03A6 c03AF
0671  0E 04      MVI C,04H
0673  06 00      MVI B,00H
CB4_LOOP:                                    ; xref: j067B
0675  0F         RRC
0676  D2 7A 06   JNC CB4_NEXT
0679  04         INR B
CB4_NEXT:                                    ; xref: j0676
067A  0D         DCR C
067B  C2 75 06   JNZ CB4_LOOP
067E  C9         RET

; CHK_NPULSE: carry if CUR_NPULSE bytes >= 6, else zero them.
CHK_NPULSE:                                  ; xref: c03BD c03CB
067F  2A A9 6F   LHLD CUR_NPULSE
0682  7D         MOV A,L
0683  D6 06      SUI 06H
0685  F2 96 06   JP CHK_NPULSE_OK
0688  7C         MOV A,H
0689  D6 06      SUI 06H
068B  F2 96 06   JP CHK_NPULSE_OK
068E  21 00 00   LXI H,RESET
0691  AF         XRA A
0692  22 A9 6F   SHLD CUR_NPULSE
0695  C9         RET
CHK_NPULSE_OK:                               ; xref: j0685 j068B
0696  37         STC
0697  C9         RET

; ADJ_PULSES: pulse-position adjustment; computes a signed 16-bit offset (NEG_HL for
; negative) and adds/subtracts BCD_DELTA into BCD_ACC with BCD_ADD4 / BCD_SUB4.
ADJ_PULSES:                                  ; xref: c074F c0761
0698  2A AB 6F   LHLD CUR_PULSES_1
069B  3A A1 6F   LDA CUR_REC
069E  E6 02      ANI 02H
06A0  CA BE 06   JZ ADJ_OFFSET
06A3  11 AA 6F   LXI D,CUR_PULSES
06A6  1A         LDAX D
06A7  47         MOV B,A
06A8  07         RLC
06A9  78         MOV A,B
06AA  D2 B4 06   JNC ADJ_SUB16
06AD  C6 10      ADI 10H
06AF  12         STAX D
06B0  2B         DCX H
06B1  C3 BB 06   JMP ADJ_STORE
ADJ_SUB16:                                   ; xref: j06AA
06B4  D6 10      SUI 10H
06B6  FA BE 06   JM ADJ_OFFSET
06B9  12         STAX D
06BA  23         INX H
ADJ_STORE:                                   ; xref: j06B1
06BB  22 AB 6F   SHLD CUR_PULSES_1
