190E  C0         RNZ
190F  3A BE 70   LDA VAR_70BE
1912  3C         INR A
1913  27         DAA
1914  FE 60      CPI 60H                     ; '`'
1916  32 BE 70   STA VAR_70BE
1919  C0         RNZ
191A  3E 00      MVI A,00H
191C  32 BE 70   STA VAR_70BE
191F  3A 50 70   LDA VAR_7050
1922  3C         INR A
1923  27         DAA
1924  FE 60      CPI 60H                     ; '`'
1926  32 50 70   STA VAR_7050
1929  C0         RNZ
192A  3E 00      MVI A,00H
192C  32 50 70   STA VAR_7050
192F  3A 51 70   LDA VAR_7051
1932  3C         INR A
1933  27         DAA
1934  FE 24      CPI 24H                     ; '$'
1936  32 51 70   STA VAR_7051
1939  C0         RNZ
193A  3E 00      MVI A,00H
193C  32 51 70   STA VAR_7051
193F  C9         RET
