18CC  27         DAA
18CD  FE 60      CPI 60H                     ; '`'
18CF  32 4F 70   STA VAR_704F
18D2  C2 FE 18   JNZ L_18FE
18D5  3E 00      MVI A,00H
18D7  32 4F 70   STA VAR_704F
18DA  3A CD 70   LDA SW_LO
18DD  3C         INR A
18DE  27         DAA
18DF  FE 60      CPI 60H                     ; '`'
18E1  32 CD 70   STA SW_LO
18E4  C2 FE 18   JNZ L_18FE
18E7  3E 00      MVI A,00H
18E9  32 CD 70   STA SW_LO
18EC  3A CC 70   LDA SW_HI
18EF  3C         INR A
18F0  27         DAA
18F1  FE 24      CPI 24H                     ; '$'
18F3  32 CC 70   STA SW_HI
18F6  C2 FE 18   JNZ L_18FE
18F9  3E 00      MVI A,00H
18FB  32 CC 70   STA SW_HI
L_18FE:                                      ; xref: j18C5 j18D2 j18E4 j18F6
18FE  3A BF 70   LDA STATUS_BITS
1901  07         RLC
1902  D8         RC
